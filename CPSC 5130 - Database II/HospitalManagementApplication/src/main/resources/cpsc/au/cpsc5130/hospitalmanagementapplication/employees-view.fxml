<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="10"
      fx:controller="cpsc.au.cpsc5130.hospitalmanagementapplication.EmployeesController"
        stylesheets="@employees-view.css">
    <!-- Add some padding around the entire layout -->
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <VBox styleClass="header-container">
        <Label text="Hospital Employee Database" styleClass="header-label"/>
    </VBox>

    <!-- TableView at the top (with Contact Info column added) -->
    <TableView fx:id="employeeTable" prefHeight="300" styleClass="employee-table">
        <columns>
            <TableColumn fx:id="colEmployeeId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colFirstName" text="First Name" prefWidth="100"/>
            <TableColumn fx:id="colLastName" text="Last Name" prefWidth="100"/>
            <TableColumn fx:id="colJobCategory" text="Job Category" prefWidth="120"/>
            <TableColumn fx:id="colDepartment" text="Department" prefWidth="120"/>
            <TableColumn fx:id="colContactInfo" text="Contact Info" prefWidth="120"/>
        </columns>
    </TableView>

    <VBox styleClass="header-container">
        <Label text="Employee Details" styleClass="header-label"/>
    </VBox>

    <!-- 2x3 GridPane for the form fields -->
    <GridPane hgap="10" vgap="10">
        <!-- Make both columns expand equally -->
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <!-- ROW 0: Employee ID (col 0), First Name (col 1) -->
        <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="0">
            <Label text="Employee ID:"/>
            <TextField fx:id="txtEmployeeId" editable="false" />
        </HBox>
        <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <Label text="First Name:"/>
            <TextField fx:id="txtFirstName" />
        </HBox>

        <!-- ROW 1: Last Name (col 0), Job Category (col 1) -->
        <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="0">
            <Label text="Last Name:"/>
            <TextField fx:id="txtLastName" />
        </HBox>
        <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="1">
            <Label text="Job Category:"/>
            <ComboBox fx:id="comboJobCategory" />
        </HBox>

        <!-- ROW 2: Department (col 0), Contact Info (col 1) -->
        <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="0">
            <Label text="Department:"/>
            <ComboBox fx:id="comboDepartment" />
        </HBox>
        <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <Label text="Contact Info:"/>
            <TextField fx:id="txtContactInfo" />
        </HBox>
    </GridPane>

    <!-- CRUD Buttons at the bottom -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="Add" onAction="#handleAdd"/>
        <Button text="Update" onAction="#handleUpdate"/>
        <Button text="Delete" onAction="#handleDelete"/>
    </HBox>
</VBox>
