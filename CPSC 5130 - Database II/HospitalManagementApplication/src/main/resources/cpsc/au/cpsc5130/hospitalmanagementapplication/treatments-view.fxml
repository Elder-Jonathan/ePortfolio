<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="12"
      fx:controller="cpsc.au.cpsc5130.hospitalmanagementapplication.TreatmentsController"
      stylesheets="@treatments-view.css">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Full-Width Header -->
    <VBox styleClass="header-container" GridPane.columnIndex="0" GridPane.columnSpan="5">
        <Label text="Level 1 Room Status" styleClass="header-label"/>
    </VBox>

    <!-- Styled TableView -->
    <TableView fx:id="treatmentTable" prefHeight="300" styleClass="treatment-table">
        <columns>
            <TableColumn fx:id="colTreatmentId" text="ID" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Name" prefWidth="500"/>
        </columns>
    </TableView>

    <!-- Treatment Details Section -->
    <VBox spacing="8" styleClass="details-container">
        <Label text="Treatment Details" styleClass="header-label"/>

        <HBox spacing="8">
            <Label text="Treatment Name:" styleClass="label-title"/>
            <TextField fx:id="txtName" prefWidth="250"/>
        </HBox>

        <VBox spacing="4">
            <Label text="Description:" styleClass="label-title"/>
            <TextArea fx:id="txtDescription" prefWidth="450" prefRowCount="5" wrapText="true" styleClass="description-text"/>
        </VBox>
    </VBox>

    <!-- Buttons -->
    <HBox spacing="15" alignment="CENTER">
        <Button text="Add" onAction="#handleAdd" styleClass="button-add"/>
        <Button text="Update" onAction="#handleUpdate" styleClass="button-update"/>
        <Button text="Delete" onAction="#handleDelete" styleClass="button-delete"/>
    </HBox>
</VBox>
