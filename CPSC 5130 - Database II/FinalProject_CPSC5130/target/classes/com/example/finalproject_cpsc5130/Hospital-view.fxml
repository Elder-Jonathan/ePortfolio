<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.finalproject_cpsc5130.HospitalController">
    <top>
        <Label text="Hospital Database Management" style="-fx-font-size: 24px; -fx-padding: 10px;" BorderPane.alignment="CENTER"/>
    </top>

    <left>
        <VBox spacing="10">
            <Text text="Section 1 - Room Utilization" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
            <Label text="List the rooms that are occupied:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="List occupied rooms" onAction="#listOccupiedRooms"/>
            <Label text="List the rooms that are currently unoccupied:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="List unoccupied rooms" onAction="#listUnoccupiedRooms"/>
            <Label text="List all rooms in the hospital:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="List all rooms" onAction="#listAllRooms"/>

            <Text text="Section 2 - Patient Information" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
            <Label text="List all patients in the database:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="List all patients" onAction="#listAllPatients"/>
            <Label text="List all patients currently admitted:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="List current patients" onAction="#listCurrentPatients"/>
            <Label text="List all patients who were discharged in a given date range:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="List discharged patients by date" onAction="#listDischargedPatientsByDate"/>
            <Label text="List all patients who were admitted in a given date range:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="List admitted patients by date" onAction="#listAdmittedPatientsByDate"/>
            <Label text="Find patient details by ID/Name:"/>
            <TextField fx:id="patientSearchField" promptText="Enter patient ID/Name"/>
            <Button text="Search" onAction="#searchPatientDetails"/>
            <Label text="List all doctors that work at the hospital:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="List all doctors" onAction="#listAllDoctors"/>
            <Label text="List doctors with current patients:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="List doctors with current patients" onAction="#listDoctorsWithCurrentPatients"/>
            <Label text="Find doctor details by ID:"/>
            <TextField fx:id="doctorIdField" promptText="Enter doctor ID"/>
            <Button text="Search Diagnosis Stats" onAction="#doctorSpecificDiagnosisStats"/>
            <Button text="Search Treatment Stats" onAction="#doctorSpecificTreatmentStats"/>

            <Text text="Section 3 - Diagnosis and Treatment Info" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
            <Label text="List the diagnoses given to patients, in descending order of occurrences:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="Diagnoses by occurrence" onAction="#listDiagnosesByOccurrences"/>
            <Label text="List the treatments performed on admitted patients, in descending order of occurrences:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="Treatment occurrence stats" onAction="#treatmentOccurrenceStats"/>
            <Label text="Treatment orderer and patient details by ID:"/>
            <TextField fx:id="patientTreatmentIdField" promptText="Enter PatientTreatmentID"/>
            <Button text="Search" onAction="#treatmentOrdererAndPatientInfo"/>

            <Text text="Section 4 - Employee Information" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
            <Label text="List all workers at the hospital:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="List all employees" onAction="#listAllEmployees"/>
            <Label text="List the primary doctors of patients with a high admission rate:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="Doctors with high admission rate patients" onAction="#doctorsWithHighAdmissionRatePatients"/>
            <Label text="Employees treating all patients:" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <Button text="Employees treating all patients" onAction="#employeesTreatingAllPatients"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <TableView fx:id="resultTable" prefWidth="600" prefHeight="400"/>
        </VBox>
    </center>
</BorderPane>